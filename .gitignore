# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Cloudflare Pages local dev secrets — never commit
.dev.vars
.dev.vars.local
.wrangler/

# 원본 이미지 자산 — scripts/process-mascot.ts로 처리 후 public/에만 배포
image/
Character image/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 자료 — 2026-05-05 사용자 승인으로 비공개 저장소에 모두 포함 (이전 ignore 해제)
capture.log

# 생성된 포트폴리오 PDF (수십 MB — pnpm pdf 산출물, 저장소 비대화 방지)
/*.pdf
